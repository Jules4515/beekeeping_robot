<?xml version="1.0"?>
<robot name="four_wheel_robot">

    <!-- Materials -->
    <material name="blue">
        <color rgba="0.0 0.5 0.8 1.0" />
    </material>
    <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0" />
    </material>
    <material name="silver">
        <color rgba="0.75 0.75 0.75 1.0" />
    </material>

    <!-- Dimensions (hardcoded, meters) -->
    <!-- chassis: length=1.4, width=1.0, depth=0.23, bottom height=0.6 -->
    <!-- Chassis center at z = 0.6 + 0.23/2 = 0.715 -->
    <!-- Wheelbase = 0.97, half = 0.485 -->
    <!-- Track width = 0.84, half = 0.42 -->
    <!-- Wheel radius = 0.215 -->
    <!-- Sensor height = 0.6 + 0.23 = 0.83 -->
    <!-- Front/back x offset for camera/lidar = 0.7 (chassis length/2) -->

    <!-- =========================== -->
    <!-- Base Link                   -->
    <!-- =========================== -->
    <link name="base_link" />

    <!-- =========================== -->
    <!-- Chassis                      -->
    <!-- =========================== -->
    <link name="chassis">
        <visual>
            <geometry>
                <box size="1.4 1.0 0.23" />
            </geometry>
            <origin xyz="0 0 0.715" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="1.4 1.0 0.23" />
            </geometry>
            <origin xyz="0 0 0.715" rpy="0 0 0" />
        </collision>
        <inertial>
            <mass value="10.0" />
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
        </inertial>
    </link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link" />
        <child link="chassis" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- =========================== -->
    <!-- Wheels                       -->
    <!-- =========================== -->
    <!-- Macro expanded manually -->

    <!-- Front Left -->
    <link name="front_left_link">
        <visual>
            <geometry>
                <cylinder radius="0.215" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57079632679 0 0" /> <!-- 90° about X to make cylinder vertical -->
            <material name="dark_gray" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.215" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
        </inertial>
    </link>
    <joint name="front_left_joint" type="revolute">
        <parent link="base_link" />
        <child link="front_left_link" />
        <origin xyz="0.485 -0.42 0.215" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="10" lower="-1e308" upper="1e308" />
        <dynamics damping="0.1" friction="0.1" />
    </joint>

    <!-- Front Right -->
    <link name="front_right_link">
        <visual>
            <geometry>
                <cylinder radius="0.215" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
            <material name="dark_gray" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.215" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
        </inertial>
    </link>
    <joint name="front_right_joint" type="revolute">
        <parent link="base_link" />
        <child link="front_right_link" />
        <origin xyz="0.485 0.42 0.215" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="10" lower="-1e308" upper="1e308" />
        <dynamics damping="0.1" friction="0.1" />
    </joint>

    <!-- Rear Left -->
    <link name="rear_left_link">
        <visual>
            <geometry>
                <cylinder radius="0.215" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
            <material name="dark_gray" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.215" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
        </inertial>
    </link>
    <joint name="rear_left_joint" type="revolute">
        <parent link="base_link" />
        <child link="rear_left_link" />
        <origin xyz="-0.485 -0.42 0.215" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="10" lower="-1e308" upper="1e308" />
        <dynamics damping="0.1" friction="0.1" />
    </joint>

    <!-- Rear Right -->
    <link name="rear_right_link">
        <visual>
            <geometry>
                <cylinder radius="0.215" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
            <material name="dark_gray" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.215" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
        </inertial>
    </link>
    <joint name="rear_right_joint" type="revolute">
        <parent link="base_link" />
        <child link="rear_right_link" />
        <origin xyz="-0.485 0.42 0.215" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="100" velocity="10" lower="-1e308" upper="1e308" />
        <dynamics damping="0.1" friction="0.1" />
    </joint>

    <!-- =========================== -->
    <!-- Camera & LiDAR               -->
    <!-- =========================== -->
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.07" />
            </geometry>
            <origin xyz="0 0 0" />
            <material name="silver" />
        </visual>
        <inertial>
            <mass value="0.1" />
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
        </inertial>
    </link>

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.07" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="silver" />
        </visual>
        <inertial>
            <mass value="0.2" />
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
        </inertial>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_link" />
        <origin xyz="0.7 0 0.83" rpy="0 0 0" />
    </joint>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar_link" />
        <origin xyz="0.7 0 0.83" rpy="0 0 0" />
    </joint>

    <!-- base_footprint for ground reference -->
    <link name="base_footprint" />
    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link" />
        <child link="base_footprint" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

</robot>