<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bee_mobile</name>
  <version>1.0.0</version>
  <description>ROS 2 package for the Beekeeping Mobile Robot's autonomous navigation</description>
  <maintainer email="jules.guignard2004@gmail.com">Jules GUIGNARD</maintainer>
  <license>MIT</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_simple_commander</depend>
  <depend>ament_index_python</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nmea_navsat_driver</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
